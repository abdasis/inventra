{
    "name": "inventra/monorepo",
    "description": "Inventra - Modern Office Asset and Inventory Management System Monorepo",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5"
    },
    "autoload": {
        "psr-4": {
            "Inventra\\Core\\": "apps/api/src/Core/",
            "Inventra\\Api\\": "apps/api/src/",
            "Inventra\\Web\\": "apps/web/src/"
        }
    },
    "scripts": {
        "setup": [
            "@composer install",
            "@php -r \"is_file('.env') || copy('.env.example', '.env');\"",
            "@php apps/api/database/migrate.php --seed"
        ],
        "serve": "@php -S 127.0.0.1:8090 -t apps/web/public apps/web/public/index.php",
        "migrate": "@php apps/api/database/migrate.php",
        "test": [
            "@php apps/api/tests/run_tests.php",
            "@php apps/api/tests/user_domain_check.php",
            "@php apps/api/tests/master_reference_check.php",
            "@php apps/api/tests/master_partner_check.php",
            "@php apps/api/tests/asset_registration_check.php",
            "@php apps/api/tests/procurement_check.php",
            "@php apps/api/tests/stock_check.php",
            "@php apps/api/tests/assignment_check.php",
            "@php apps/api/tests/loan_check.php",
            "@php apps/api/tests/transfer_check.php",
            "@php apps/api/tests/maintenance_check.php",
            "@php apps/api/tests/disposal_check.php",
            "@php apps/api/tests/report_check.php",
            "@php apps/api/tests/contract_snapshot.php",
            "@php apps/web/tests/page_snapshot.php",
            "@php apps/web/tests/redirect_check.php"
        ],
        "test:record-contract": "@php apps/api/tests/contract_snapshot.php --record",
        "test:record-pages": "@php apps/web/tests/page_snapshot.php --record"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
